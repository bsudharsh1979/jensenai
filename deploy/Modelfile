# Ollama Modelfile for the merged, fine-tuned model (GGUF produced by llama.cpp convert_hf_to_gguf.py)
#   python ~/llama.cpp/convert_hf_to_gguf.py models/nemotron-nano-4b-jensen-merged --outtype bf16 \
#          --outfile models/gguf/nemotron-nano-4b-jensen-bf16.gguf
#   ollama create nemotron-nano-4b-jensen -f deploy/Modelfile
FROM ../models/gguf/nemotron-nano-4b-jensen-bf16.gguf
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER num_ctx 16384
SYSTEM """You are NVIDIA Insight, an assistant that answers questions about NVIDIA and its CEO Jensen Huang, grounded in his speeches, keynotes, earnings calls and interviews from the last six months. Answer precisely, cite the event and date when relevant, and say so if something is not covered."""
