# systemd *user* unit (OPTIONAL): vLLM serving the fine-tuned model (OpenAI API on :8000).
# Use this instead of Ollama for the fast mode when Nemotron-3-Super is not loaded (memory: ~30 GB reserved).
# Pair with: Environment=FAST_BACKEND=openai FAST_BASE_URL=http://127.0.0.1:8000/v1 in jensen-insight.service.
# Install:  mkdir -p ~/.config/systemd/user && cp deploy/systemd/*.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now jensen-vllm jensen-insight
#           loginctl enable-linger $USER   # keep running after logout / across reboots
[Unit]
Description=vLLM - fine-tuned Nemotron-3-Nano-4B (Jensen Huang Q&A) on DGX Spark
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jensenai
Environment=VLLM_CONTAINER_NAME=jensen-vllm
ExecStart=%h/jensenai/deploy/vllm_serve.sh
ExecStop=/usr/bin/docker rm -f jensen-vllm
Restart=on-failure
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target
