# systemd *user* unit: NVIDIA Insight web app (FastAPI + RAG) on :8600.
# Generators are served by Ollama (expert: Nemotron-3-Super, fast: fine-tuned Nemotron-Nano-4B GGUF).
# Ollama must be running on :11434 (ollama serve). The optional jensen-vllm unit is NOT pulled in: on a
# 128 GB DGX Spark, vLLM's reserved memory and Nemotron-3-Super (~93 GB) cannot coexist.
[Unit]
Description=NVIDIA Insight - Jensen Huang Q&A app (FastAPI + Nemotron RAG)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jensenai
Environment=DEFAULT_MODE=expert
Environment=EXPERT_MODEL=nemotron-3-super:latest
Environment=FAST_MODEL=nemotron-nano-4b-jensen
Environment=APP_PORT=8600
ExecStart=%h/jensenai/deploy/run_app.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
